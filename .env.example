# Copy these into Vercel → Project → Settings → Environment Variables
# (and into a local .env.local file if you run the app on your own computer).

# The web address of your site, no trailing slash (e.g. https://dreamfactory.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (writes the stats) → console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Small, cheap model for the drawing check and matching the description to the picture
ANTHROPIC_FAST_MODEL=claude-haiku-5-5

# OpenAI (draws the pictures and screens the text box) → platform.openai.com → API keys
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_IMAGE_QUALITY=medium
# Read-aloud voice (preview them at openai.fm): coral, shimmer, sage, nova…
OPENAI_TTS_VOICE=sage

# Stripe → Developers → API keys, and Products → your two prices
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=
STRIPE_PRICE_MAX=
STRIPE_PRICE_UNLIMITED=

# Google sign-in button (same Client ID as in Supabase → Auth → Google). Makes Google show our domain, not supabase.co
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Resend API key (Sending access, starportdreamfactory.com). Used to email bug reports and feature requests to info@
RESEND_API_KEY=
